{
  "name": "kova-auth",
  "private": true,
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10"
    }
  },
  "scripts": {
    "dev": "pnpm --filter dashboard run dev",
    "build": "pnpm --filter dashboard run build && pnpm --filter @115jon/kova-react run build",
    "typecheck": "pnpm --filter server run typecheck && pnpm --filter @115jon/kova-react run typecheck",
    "test": "pnpm --filter server run test",
    "deploy": "pnpm --filter dashboard run deploy",
    "migrate:dev": "pnpm --filter dashboard run migrate:dev",
    "migrate:prod": "pnpm --filter dashboard run migrate:prod",
    "cf-typegen": "pnpm --filter dashboard run cf-typegen",
    "build:sdk": "pnpm --filter @115jon/kova-react run build",
    "deploy:sdk-demo": "pnpm --filter @kova/sdk-demo run deploy"
  }
}
