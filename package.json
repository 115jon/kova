{
  "name": "kova-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10",
      "better-auth": "1.6.33",
      "@better-auth/api-key": "1.6.33",
      "@better-auth/passkey": "1.6.33",
      "@better-auth/core": "1.6.33",
      "@better-auth/drizzle-adapter": "1.6.33",
      "@better-auth/kysely-adapter": "1.6.33",
      "seroval": ">=1.5.3"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "dev:preview": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1 -Mode preview",
    "dev:local": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1 -Mode full",
    "build": "vite build && pnpm run build:sdk",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && pnpm --filter @115jon/kova-react run typecheck",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler deploy",
    "migrate:dev": "wrangler d1 migrations apply kova-auth-db --local",
    "migrate:prod": "wrangler d1 migrations apply kova-auth-db --remote",
    "cf-typegen": "wrangler types",
    "generate": "better-auth generate --output migrations",
    "build:sdk": "pnpm --filter @115jon/kova-react run build",
    "deploy:sdk-demo": "pnpm --filter @kova/sdk-demo run deploy"
  },
  "dependencies": {
    "@better-auth/api-key": "~1.6.33",
    "@better-auth/passkey": "~1.6.33",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/react-router": "^1.163.3",
    "@tanstack/react-start": "^1.164.0",
    "better-auth": "~1.6.33",
    "better-auth-cloudflare": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "lucide-react": "^0.564.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.7",
    "react-icons": "^5.6.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.6",
    "@cloudflare/workers-types": "^4.20260214.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "vitest": "^4.0.15",
    "vite": "^7.3.1",
    "wrangler": "^4"
  }
}
